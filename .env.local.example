# Global admin secret — gates access to the /admin tournament creation UI.
# Never expose this in client-side code or API responses.
ADMIN_SECRET=change-me-to-a-strong-secret

# DynamoDB table name (created by CDK or manually in the AWS console)
DYNAMODB_TABLE_NAME=RefereeCallApp

# Base URL used to build absolute join links shown in the admin UI
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# AWS credentials for DynamoDB access
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Web Push (VAPID) — enables OS-level notifications to referees on new calls.
# Generate a keypair once with:  npx web-push generate-vapid-keys
# The public key is also exposed to the client via NEXT_PUBLIC_VAPID_PUBLIC_KEY
# (it must match VAPID_PUBLIC_KEY). Keep VAPID_PRIVATE_KEY secret.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Contact URI (mailto: or https:) included in push requests per the VAPID spec.
VAPID_SUBJECT=mailto:admin@example.com
